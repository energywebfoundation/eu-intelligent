{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intelligent-project.eu/ontology/v1.0.0/billing/Payment",
  "title": "int:Payment",
  "description": "A completed payment transaction against an Invoice. After each payment, Invoice.outstandingAmount is updated.",
  "type": "object",
  "properties": {
    "paymentId": {
      "description": "Primary identifier. IRI: int:paymentId. UUID v4.",
      "type": "string",
      "format": "uuid"
    },
    "invoiceId": {
      "description": "FK to Invoice. IRI: int:invoiceId. UUID v4.",
      "type": "string",
      "format": "uuid"
    },
    "paymentDate": {
      "description": "Date and time the payment was made. IRI: int:paymentDate. ISO 8601 with timezone.",
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "default": null
    },
    "paymentAmount": {
      "description": "Payment amount. IRI: int:paymentAmount.",
      "type": [
        "number",
        "null"
      ],
      "default": null
    },
    "currency": {
      "description": "Payment currency. IRI: int:currency. ISO 4217 or crypto code.",
      "type": [
        "string",
        "null"
      ],
      "maxLength": 10,
      "default": null
    },
    "paymentMethod": {
      "description": "Payment method used. IRI: int:paymentMethod.",
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "bank_transfer",
        "card",
        "sepa_debit",
        null
      ],
      "default": null
    },
    "paymentProvider": {
      "description": "Payment service provider. IRI: int:paymentProvider.",
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "stripe",
        "crypto",
        null
      ],
      "default": null
    },
    "paymentStatus": {
      "description": "Payment lifecycle status. IRI: int:paymentStatus.",
      "type": "string",
      "enum": [
        "pending",
        "succeeded",
        "failed",
        "cancelled",
        "refunded"
      ]
    },
    "createdAt": {
      "description": "Record creation timestamp. IRI: int:createdAt. ISO 8601 with timezone.",
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "description": "Record last updated timestamp. IRI: int:updatedAt. ISO 8601 with timezone.",
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "default": null
    },
    "stripeIds": {
      "description": "FKs to StripePayment records. IRI: int:stripeIds. UUID v4 array.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "default": null
    }
  },
  "required": [
    "paymentId",
    "invoiceId",
    "paymentStatus",
    "createdAt"
  ],
  "additionalProperties": false
}